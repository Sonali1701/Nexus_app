# ---- Nexus API ------------------------------------------------------------
NEXUS_BASE_URL=https://api-nexus.laboredge.com

# How to authenticate with the Nexus OAuth API.
#   static             -> paste a JWT access token below (quickest way to start)
#   password           -> POST username/password to NEXUS_TOKEN_URL
#   client_credentials -> POST client id/secret to NEXUS_TOKEN_URL
NEXUS_AUTH_METHOD=static

# Used when NEXUS_AUTH_METHOD=static
NEXUS_STATIC_TOKEN=

# Used when NEXUS_AUTH_METHOD=password or client_credentials.
# The token endpoint URL comes from your LaborEdge API credentials sheet
# (it is not included in the Resume Parser guide).
NEXUS_TOKEN_URL=
NEXUS_TOKEN_PAYLOAD_STYLE=form   # form | json
NEXUS_CLIENT_ID=
NEXUS_CLIENT_SECRET=
NEXUS_USERNAME=
NEXUS_PASSWORD=

# Optional: pin the "Candidate Resume" document type id (otherwise it is
# auto-discovered via GET /master/documenttypes).
NEXUS_RESUME_DOC_TYPE_ID=

# ---- Candidate defaults (admin sets once, users never see them) -----------
# JSON merged into every new-candidate upload. Fill this in and end users
# only drop resumes — no Nexus IDs to enter. The webhook needs either
# professionId+specialtyId or a jobId, plus stateId and jobTypeIds. The app
# automatically resolves the agency's Prospect status and USA country and
# supplies the canonical plural Candidate API fields. Values in the UI's
# candidate-details panel override these defaults.
# Example:
# NEXUS_DEFAULT_PROFILE={"professionId":123,"specialtyId":456,"stateId":1,"referralSourceId":2,"jobTypeIds":["TRAVEL"]}
NEXUS_DEFAULT_PROFILE=

# ---- Resume field extraction ----------------------------------------------
# name/email/phone are pulled from each resume automatically.
# CLAUDE_EXTRACT: auto   -> Claude fills gaps heuristics miss (default;
#                           also reads scanned image-only PDFs)
#                 always -> Claude extracts every resume
#                 never  -> heuristics only, no AI calls
# Claude requires Anthropic credentials: set ANTHROPIC_API_KEY here, or have
# an `ant auth login` profile on this machine. Without them, extraction
# silently falls back to heuristics only.
CLAUDE_EXTRACT=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Login / sessions -----------------------------------------------------
# SECRET_KEY signs the login cookie. Set any long random string; if unset,
# a random one is used and everyone is logged out on each restart.
SECRET_KEY=

# --- User store ---
# Where users live. Set MONGODB_URI for durable storage (recommended on Render;
# a free MongoDB Atlas cluster works). Without it, users live in a local
# users.json file (fine for local dev / a persistent disk).
MONGODB_URI=
MONGODB_DB=nexus_uploader

# Bootstrap admin — seeded into the store on first run so someone can log in and
# add users from the in-app Admin page. Set a strong ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional seed logins imported on startup if missing (admin can also add users
# in-app afterwards). Passwords may be plaintext or a pbkdf2 hash; add
# "admin": true to seed an admin. Example:
# APP_USERS={"alice":{"name":"Alice Smith","password":"changeme1"}}
APP_USERS=

# Session length in seconds (default 12h) and cookie hardening.
SESSION_MAX_AGE=43200
COOKIE_SECURE=false            # set true in production (HTTPS, e.g. on Render)

# Stamp "uploaded by <name>" into Nexus (document notes + a candidate note)
# so the person is visible inside Nexus, in addition to the app audit log.
UPLOADER_ATTRIBUTION=true
# Where the audit log is appended (stdout always gets it too).
AUDIT_LOG_PATH=

# ---- App ------------------------------------------------------------------
APP_PORT=8020
